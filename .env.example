# Gemini / Google Cloud (Required for card scanning)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=True
GEMINI_API_KEY=your-actual-gemini-api-key-here

# App configuration
JWT_SECRET=super-secret-demo-key-change-me
DATA_PROVIDER=postgres

# Database (Handled via Docker Compose service named "postgres")
APP_DATABASE_URL=postgresql+asyncpg://postgres:password@postgres:5432/pokemon
DB_NAME=pokemon
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=postgres
DB_PORT=5432

# Frontend configuration
VITE_API_BASE_URL=